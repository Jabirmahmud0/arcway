# Copy this file to .env and fill in your values
# Never commit .env — only this template

# Neon PostgreSQL: pooled URL for the application (copy from Neon Connect)
DATABASE_URL=postgresql://USER:PASSWORD@ep-YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Optional direct URL for migration commands; defaults to DATABASE_URL if omitted
DATABASE_MIGRATION_URL=postgresql://USER:PASSWORD@ep-YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Auth / Session
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# App
NODE_ENV=development
PORT=3001

# AI providers (server-side secrets, never VITE_ variables)
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=qwen/qwen3.8-27b

# Existing Forge storage/notification adapter (independent from AI)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Clerk: use the same public key for Vite and Express
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3001,http://127.0.0.1:3001
# Optional: Clerk user_... ID that should have reviewer privileges
OWNER_OPEN_ID=

# Private disk storage. Keep this directory on a persistent volume in production.
STORAGE_LOCAL_DIR=.data/uploads
# Gmail read-only connection (Google OAuth web application credentials)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3001/api/integrations/gmail/callback
# Generate 32 random bytes, encoded as 64 hexadecimal characters; do not rotate
# without reconnecting Gmail. Tokens are encrypted in this private directory.
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_TOKEN_DIR=.data/integrations

# Native operational worker; works with Clerk and needs no paid scheduler.
OPERATIONAL_SCHEDULER_ENABLED=true
# Optional external cron endpoint bearer token (32+ random characters).
# Leave empty to disable external access; the native worker still runs.
SCHEDULER_SECRET=
AI_EVALUATION_DIR=.data/evaluations

# Backup tooling uses a direct Neon connection; defaults to migration/app URL.
BACKUP_DATABASE_URL=
BACKUP_DIR=.data/backups
# Optional executable paths; standard Windows PostgreSQL installations are detected.
PG_DUMP_PATH=
PG_RESTORE_PATH=
# Restore commands require a separate EMPTY database and EMPTY data directory.
RESTORE_DATABASE_URL=
RESTORE_DATA_DIR=
