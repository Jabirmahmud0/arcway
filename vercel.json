{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build:vercel",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install --frozen-lockfile --prod=false",
  "env": { "ARCWAY_DEPLOYMENT_MODE": "demo" },
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/.pnpm/{@napi-rs+canvas*,pdfjs-dist*,pdf-parse*}/**",
      "excludeFiles": "{.data/**,.env,.env.*,docs/**,deploy/**,drizzle/postgresql/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/manus-storage/:path*", "destination": "/api/index" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ],
  "crons": [ { "path": "/api/scheduled/operationalSweep", "schedule": "0 0 * * *" } ]
}
